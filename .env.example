# ─── App ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=AdSphere
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://adsphere:adsphere@localhost:5432/adsphere
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:4000/api/auth/discord/callback

# ─── Encryption ───────────────────────────────────────
ENCRYPTION_KEY=change-this-to-a-32-char-key

# ─── Payment ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── Email ────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@adsphere.io

# ─── Storage ──────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ─── Redis Queue ─────────────────────────────────────
REDIS_QUEUE_URL=redis://localhost:6379/1

# ─── Session ──────────────────────────────────────────
SESSION_SECRET=change-this-session-secret

# ─── Rate Limit ───────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
